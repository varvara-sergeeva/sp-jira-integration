mixin adva(modifier)
  section.adva
    .adva__container.container
      h2.adva__title
        span главные преимущества
        span [SP] офферов
      .adva__body
        .adva__list
          .adva__item
            h3 НЕТ ХОЛДА
            p его совсем нет.<br><span>Все лиды получают<br> статусы моментально</span>
          .adva__item
            h3 Пожизненный доход
            p <span>с активных клиентов от&nbsp;50%</span>
          .adva__item
            h3 Самый большой<br> выбор офферов
            p под различные тематики
          .adva__item.animated-items
          .adva__item
            h3 Оперативное<br> добавление<br> лендингов<br> по запросу
          .adva__item
            h3 Повышенные ставки
            p в зависимости<br> от качества трафика
          .adva__item.animated-items
          .adva__item.adva__item-8
            h3 Адаптированная статистика
            p специально под&nbsp;SP&nbsp;офферы
          .adva__item
            h3 Создание<br> приватных<br> офферов<br> <span>под ключ</span>
          .adva__item
            .adva__box
            .adva__box
            .adva__box