mixin intro(modifier)
  section.intro
    .intro__container.container
      .intro__info
        h1.intro__title
          span Лей на самую горячую вертикаль
          span SP&nbsp;офферы.
          p.intro__subtitle Запускай трафик на <span>SP офферы</span> из любых источников
      .intro__ticker
        p
          +tiker-icon
        p
          +tiker-icon



